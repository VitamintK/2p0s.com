<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} — 2p0s</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }

    :root {
      --color-1: #dc2626;
      --color-2: #2563eb;
    }

    body {
      font-family: system-ui, sans-serif;
      max-width: 860px;
      margin: 0 auto;
      padding: 2rem 1rem;
      color: #1a1a1a;
    }

    header {
      margin-bottom: 2rem;
    }

    nav a {
      font-weight: 600;
      text-decoration: none;
      color: inherit;
    }

    h1 { font-size: 1.75rem; }
    h2 { font-size: 1.25rem; margin-top: 2rem; }

    table {
      border-collapse: collapse;
      width: 100%;
      margin: 1rem 0;
    }

    th, td {
      text-align: left;
      padding: 0.5rem 0.75rem;
      border-bottom: 1px solid #e0e0e0;
    }

    th { font-weight: 600; background: #f5f5f5; }

    .tag-1, .tag-2, .tag-total {
      display: inline-block;
      padding: 0.05rem 0.35rem;
      border-radius: 3px;
      font-weight: 600;
    }

    .tag-1 { border: 1px solid var(--color-1); color: var(--color-1); background: color-mix(in srgb, var(--color-1) 12%, white); }
    .tag-2 { border: 1px solid var(--color-2); color: var(--color-2); background: color-mix(in srgb, var(--color-2) 12%, white); }
    .tag-total { border: 1px solid #1a1a1a; }

    a { color: #2563eb; }

    .tooltip {
      position: relative;
      text-decoration: underline dotted var(--color-2);
      text-underline-offset: 0.2em;
      cursor: help;
    }

    .tooltip-body {
      display: none;
      position: absolute;
      top: calc(100% + 0.4rem);
      right: 0;
      z-index: 10;
      width: max-content;
      max-width: min(18rem, calc(100vw - 2rem));
      padding: 0.5rem 0.75rem;
      background: #fff;
      border: 1px solid #a2a9b1;
      border-radius: 2px;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
      font-size: 0.875rem;
      line-height: 1.4;
      overflow-wrap: anywhere;
      cursor: auto;
    }

    .tooltip:hover .tooltip-body,
    .tooltip:focus .tooltip-body { display: block; }

    footer.credit {
      position: fixed;
      bottom: 0.75rem;
      right: 1rem;
      font-size: 0.8rem;
      color: #888;
    }

    footer.credit a { color: inherit; }
  </style>
</head>
<body>
  <header>
    <nav>
      <a href="/">2p0s</a>
    </nav>
  </header>
  <main>
    {{ content | safe }}
  </main>
  <footer class="credit">
    by <a href="https://scientist.wang">Kevin Wang</a>
  </footer>
</body>
</html>
