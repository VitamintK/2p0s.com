<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} — 2p0s</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }

    body {
      font-family: system-ui, sans-serif;
      max-width: 860px;
      margin: 0 auto;
      padding: 2rem 1rem;
      color: #1a1a1a;
    }

    header {
      margin-bottom: 2rem;
    }

    nav a {
      font-weight: 600;
      text-decoration: none;
      color: inherit;
    }

    h1 { font-size: 1.75rem; }
    h2 { font-size: 1.25rem; margin-top: 2rem; }

    table {
      border-collapse: collapse;
      width: 100%;
      margin: 1rem 0;
    }

    th, td {
      text-align: left;
      padding: 0.5rem 0.75rem;
      border-bottom: 1px solid #e0e0e0;
    }

    th { font-weight: 600; background: #f5f5f5; }

    a { color: #2563eb; }
  </style>
</head>
<body>
  <header>
    <nav>
      <a href="/">2p0s</a>
    </nav>
  </header>
  <main>
    {{ content | safe }}
  </main>
</body>
</html>
